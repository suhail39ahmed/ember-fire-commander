rules_version = '2';
// EMBER: backend-mediated. No browser reads or writes, ever.
// ember-api / voice-gateway / ember-agents use the Admin SDK (IAM), which
// is not affected by these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

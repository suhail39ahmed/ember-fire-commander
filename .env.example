# Firebase Project ID (public)
VITE_FIREBASE_PROJECT_ID=ember-fire-commander

# Firebase Web Config (public client identifiers)
VITE_FIREBASE_AUTH_DOMAIN=ember-fire-commander.firebaseapp.com
VITE_FIREBASE_API_KEY=your-firebase-api-key-here
VITE_FIREBASE_APP_ID=your-firebase-app-id-here
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id-here

# Firebase Cloud Messaging (public VAPID key)
VITE_FIREBASE_VAPID_KEY=your-vapid-public-key-here

# App Check (public site key)
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=your-recaptcha-site-key-here
# Local development only: a debug token registered in Firebase Console > App Check.
# Keep the real value in apps/web/.env.local; never commit it.
# VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Google Maps (public browser key with referrer + API restrictions)
VITE_MAPS_BROWSER_KEY=your-maps-browser-key-here
VITE_MAPS_MAP_ID=your-map-id-here

# Backend URLs
# Local Python process ports. Cloud Run's PORT overrides these.
EMBER_API_PORT=8080
EMBER_AGENTS_PORT=8082
EMBER_VOICE_GATEWAY_PORT=8084
# API process: comma-separated browser origins (scheme + host + port, no path).
# Local Vite origin; this allows the API's methods and authentication headers.
ALLOWED_ORIGINS=http://localhost:5173
# Deployed API: Terraform configures these Firebase Hosting origins.
# ALLOWED_ORIGINS=https://ember-fire-commander.web.app,https://ember-fire-commander.firebaseapp.com
# Add custom frontend domains with Terraform allowed_origins_extra.
# VITE_* backend URLs below are destinations, not browser origins.
VITE_EMBER_API_URL=http://localhost:8080
VITE_VOICE_GATEWAY_WSS_URL=ws://localhost:8084

# Volunteer PWA (src/pwa). VITE_API_BASE_URL wins; VITE_EMBER_API_URL is the fallback
# used by src/auth and the deploy-web workflow.
VITE_API_BASE_URL=http://localhost:8080

# Non Local URLS
# VITE_EMBER_API_URL=https://ember-api-xmjvsg4o6a-as.a.run.app
# VITE_VOICE_GATEWAY_WSS_URL=wss://voice-gateway-xmjvsg4o6a-as.a.run.app
# VITE_API_BASE_URL=https://ember-api-xmjvsg4o6a-as.a.run.app

FIGMA_TOKEN=your-figma-token-here

# In-browser mock ember-api with synthetic data. Only "true" turns it on.
VITE_USE_MOCK_API=false

# API process only: local agents service (Cloud Run URL in deployed environments).
# EMBER_AGENTS_URL=http://localhost:8082

# ember-api: show the simulated-demo strip when ops/config.demoMode is unset.
# DEMO_MODE=true

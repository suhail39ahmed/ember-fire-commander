rules_version = '2';
// EMBER: deny-all for the Firebase Storage client SDK.
// Photos are uploaded ONLY with signed URLs minted by ember-api.
// Only needed if you ever link a bucket to Firebase Storage; the Terraform
// photo bucket is NOT linked, so the client SDK can't reach it at all.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
